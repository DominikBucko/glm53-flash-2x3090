# Absolute host path to the checkpoint prepared by scripts/download_model.sh.
MODEL_DIR=/models/glm53-flash-exl3-3.05bpw
PORT=8000

# Everything else defaults to the measured 256K agent profile baked into the image
# (configs/2x3090-256k-agent.env). Set a variable here to override it, for example:
# SERVED_MODEL_NAME=GLM-5.3-Flash
# MAX_MODEL_LEN=131072
# VLLM_API_KEY=change-me

# CPU expert pools are planned from the host topology (runtime/glm53_host.py). To pin them by hand:
# EXL3_HYBRID_CPUS_R0=0,1,2,8,9,10,16,17,18,24,25,26
# EXL3_HYBRID_CPUS_R1=4,5,6,12,13,14,20,21,22,28,29,30
# HYBRID_MAIN_CPUS=3,7,11,15,19,23,27,31,35,39,43,47,51,55,59,63
# EXL3_HYBRID_THREADS=12

# Experimental agent switches: cat configs/agent-experimental.env >> .env
