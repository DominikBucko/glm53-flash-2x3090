[Unit]
Description=GLM-5.3-Flash 2x3090 container
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# Copy this file to /etc/systemd/system only after replacing both paths and
# creating the EnvironmentFile (MODEL_DIR, PORT, overrides). Do not commit credentials to that file.
EnvironmentFile=/etc/glm53-flash.env
WorkingDirectory=/opt/glm53-flash-2x3090
ExecStart=/opt/glm53-flash-2x3090/scripts/docker_serve.sh
ExecStop=/usr/bin/docker stop -t 45 glm53-flash
Restart=on-failure
RestartSec=30
TimeoutStartSec=1800
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
