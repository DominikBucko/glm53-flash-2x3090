# Long single prompts: prefix caching off. Append to .env: cat configs/prefill-256k.env >> .env
# With prefix caching on, vLLM keeps the KDA recurrent state aligned to cache blocks ("align" mode), which costs
# prefill throughput that grows with prompt length. Use this profile when requests do not share prefixes, for
# example one-shot document or repository analysis. Multi-turn agents are faster with the default profile.
PREFIX_CACHING=0
