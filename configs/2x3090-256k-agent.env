# 2x RTX 3090 + 128 GB RAM, 262,144-token context, one request at a time. Baked into the image as the default.
# Every value is a default: variables already set in the container environment (docker_serve.sh passes .env)
# win. Measured with exactly these values; see benchmarks/ and docs/performance.md before changing them.

SERVED_MODEL_NAME=GLM-5.3-Flash
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_MEMORY_BYTES=3328599040
GPU_MEMORY_UTILIZATION=0.94
TENSOR_PARALLEL_SIZE=2
CUDA_GRAPH_MODE=FULL_DECODE_ONLY
PREFIX_CACHING=1

# Routed experts: an exact-size host copy of every expert not pinned on a GPU (UVA), a per-layer LRU cache of
# experts in VRAM sized by the capacity plan, of which the hottest 20% are pinned permanently (no host copy).
CPU_OFFLOAD_GB=64
EXL3_DYNAMIC_LRU=1
EXL3_DYNAMIC_LRU_MAX_LAYER_ID=44
EXL3_DYNAMIC_LRU_MAX_TOKENS=1
EXL3_LRU_CAPACITY_PLAN=/opt/glm53/configs/lru-plan-2x3090-13312m-k3.json
EXL3_VMM_HOT_RANKINGS=/opt/glm53/configs/hot-expert-rankings.json
EXL3_VMM_HOT_EXPERTS=72
EXL3_PINNED_FRAC=0.2
VLLM_UVA_OFFLOAD_EXACT_HOST_REGISTER=1
EXL3_LRU_GATHER_IMPL=cuda
EXL3_LRU_GATHER_BLOCK=1024
EXL3_LRU_GATHER_WARPS=8
EXL3_LRU_FUSED_GATHER=0
EXL3_LRU_OVERLAP=0
EXL3_LRU_COPY_STREAM_PRIORITY=0
EXL3_LRU_HYBRID_PREFILL=0
EXL3_LRU_SLRU_PROTECTED_PCT=0
EXL3_LRU_LOG_EVERY=0
EXL3_PREFETCH_K=0

# Decode: cold experts of 42 MoE layers are computed by one CPU thread pool per GPU (pools from glm53_host.py),
# the GPU takes 30% of each cold set over PCIe.
EXL3_HYBRID_CPU=1
EXL3_HYBRID_LAYERS=42
EXL3_HYBRID_GPU_FRAC=0.3
EXL3_HYBRID_ADMIT_CPU=0
EXL3_HYBRID_FUSED_SUBMIT=1
EXL3_HYBRID_OVERLAP_GATHER=1
OMP_NUM_THREADS=1

# Prefill: 8,192-token chunks; cold experts are staged to the GPU over PCIe 8 at a time.
EXL3_PREFILL_DMA_STAGE_EXPERTS=8
EXL3_PREFILL_DMA_MIN_TOKENS=64
EXL3_PREFILL_DMA_FAT_MODE=sorted

# EXL3 MoE kernels
EXL3_FUSED_MOE=1
EXL3_MOE_GEMV=1
EXL3_BF16_IO=1
EXL3_FUSED_DECODE_ROUTE_PREP=1
EXL3_MERGED_QKV=1
EXL3_MOE_HIT_GROUPS=6
EXL3_MOE_MISS_GROUPS=2
EXL3_MOE_MAX_SMS_PER_EXPERT=32
EXL3_MOE_DECODE_GROUPS=0
EXL3_MOE_DECODE_GROUPS_MAX_TOKENS=1
EXL3_MOE_PREFILL_HOT_GROUPS=0
EXL3_MOE_PREFILL_COLD_GROUPS=0
EXL3_MOE_PREFILL_HYBRID_GROUPS=0
EXL3_MOE_ROW_TILE=0
EXL3_TEMP_ROWS_FUSED=128
EXL3_FAT_KERNEL=0
EXL3_FAT_BATCHED=0
EXL3_FAT_SORTED=1
EXL3_MULTILINEAR_GATE_UP=0
EXL3_MULTILINEAR_MAX_ROWS=32
EXL3_DETERMINISTIC_MOE=0
# The shared expert runs on the main stream: its EXL3 kernels are cooperative full-grid launches that share a
# workspace with the routed experts, and overlapping them on a second stream can deadlock both GPUs.
VLLM_DISABLE_SHARED_EXPERTS_STREAM=1

# GLM-5.3 attention, mHC and router kernels (SM86)
GLM53_FAST_MHC=1
GLM53_FAST_ROUTER=1
GLM53_FAST_TOPK=1
GLM53_SKIP_DUP_ROUTER=1
GLM53_SPARSE_MLA_KV_SPLITS=32
VLLM_GLM53_SM86_TILELANG_MHC=split
VLLM_GLM53_SM86_MLA_QUERY_CHUNK=256
VLLM_GLM53_INDEXER_HEADS=16
VLLM_GLM53_INDEXER_WS_BY_SEQS=1
VLLM_GLM53_EMBED_UVA=1
VLLM_GLM53_DETERMINISTIC_TOPK=0
VLLM_KV_CACHE_LAYOUT=LBHNC

# Agents: reasoning is bounded at 4,096 tokens with a closing sentence, and the server re-attaches the reasoning
# of the last 4 tool-calling turns that clients drop from history (GLM otherwise stops thinking and loops).
VLLM_DEFAULT_THINKING_TOKEN_BUDGET=4096
GLM53_PRESERVE_REASONING_TURNS=4
CHAT_TEMPLATE=/opt/glm53/configs/chat-template-bounded.jinja
REASONING_CONFIG={"reasoning_start_str":"<think>","reasoning_end_str":"\n\nI have thought about this enough; I will now act on my best plan.\n</think>"}
