# Experimental agent switches, off by default. Append to .env to try them: cat configs/agent-experimental.env >> .env
# Neither has a full AgentBench run that shows a gain yet; see docs/agents.md.

# Constrain tool calls with xgrammar's glm_4_7 grammar after </think>: the name must be one of the request's
# tools and the arguments must match its schema. Fixed the replayed malformed calls (replace_file_part,
# "replace�_in_file") that end an agent task; free-text answers are unaffected.
GLM53_STRICT_TOOL_GRAMMAR=1

# Forbid ending reasoning (and <tool_call> / EOS) for the first 64 reasoning tokens of every turn. Removes
# zero-reasoning turns (51% of turns otherwise) but made turns 1.75x longer without a measured quality gain.
# VLLM_MIN_THINKING_TOKENS=64
# VLLM_MIN_THINKING_BAN_IDS=154843,154820,154827,154829
